 export function invertFileFolding(fileContentBox, foldArrow) {
   setFileFolding(fileContentBox, foldArrow, fileContentBox.getAttribute('data-folded') !== 'true');
 }
+
+// pierrejo: expose folding so the Pierre file-tree hydration bridge can expand
+// the selected diff box on tree selection / hashchange, exactly like the
+// native DiffFileTree.vue component did.
+if (typeof window !== 'undefined') {
+  window._pierreSetFileFolding = setFileFolding;
+}
