diff --git a/services/gitdiff/pierre_tree.go b/services/gitdiff/pierre_tree.go
new file mode 100644
index 000000000..b2444ee4d
--- /dev/null
+++ b/services/gitdiff/pierre_tree.go
@@ -0,0 +1,224 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package gitdiff
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"html/template"
+	"io"
+	"net/http"
+	"os"
+	"strings"
+)
+
+type pierreTreeStatus struct {
+	Path   string `json:"path"`
+	Status string `json:"status"`
+}
+
+type pierreTreeRequest struct {
+	ID        string             `json:"id"`
+	Paths     []string           `json:"paths"`
+	GitStatus []pierreTreeStatus `json:"gitStatus"`
+	Selected  string             `json:"selected,omitempty"`
+	Theme     string             `json:"theme"`
+}
+
+// pierreDiffStatus maps a Forgejo DiffFileType to a Pierre git status keyword.
+// Pierre has no "copied" status; a copied file is a new file, so it maps to
+// "added" (same green treatment the native tree used for copies).
+func pierreDiffStatus(t DiffFileType) string {
+	switch t {
+	case DiffFileAdd:
+		return "added"
+	case DiffFileChange:
+		return "modified"
+	case DiffFileDel:
+		return "deleted"
+	case DiffFileRename:
+		return "renamed"
+	case DiffFileCopy:
+		return "added"
+	default:
+		return ""
+	}
+}
+
+// PierreFileTree returns a server-rendered Pierre file tree (declarative shadow
+// DOM) for a Forgejo diff's file list. It is opt-in: unless PIERRE_FILE_TREE is
+// "true" it returns "" so the template renders Forgejo's native (default) file
+// tree. It also returns "" when the sidecar is unavailable or produces nothing.
+func PierreFileTree(files []*DiffFile, theme string) template.HTML {
+	if os.Getenv("PIERRE_FILE_TREE") != "true" {
+		return ""
+	}
+	if len(files) == 0 {
+		return ""
+	}
+
+	paths := make([]string, 0, len(files))
+	status := make([]pierreTreeStatus, 0, len(files))
+	for _, file := range files {
+		if file == nil || file.Name == "" {
+			continue
+		}
+		paths = append(paths, file.Name)
+		if s := pierreDiffStatus(file.Type); s != "" {
+			status = append(status, pierreTreeStatus{Path: file.Name, Status: s})
+		}
+	}
+	if len(paths) == 0 {
+		return ""
+	}
+
+	html, ok := pierreTreeRender("pierre-file-tree", paths, status, "", theme)
+	if !ok {
+		return ""
+	}
+	return html
+}
+
+func pierreTreeRender(id string, paths []string, status []pierreTreeStatus, selected, theme string) (template.HTML, bool) {
+	socketPath := pierreSocketPath()
+	if socketPath == "" || len(paths) == 0 {
+		return "", false
+	}
+
+	payload, err := json.Marshal(pierreTreeRequest{
+		ID:        id,
+		Paths:     paths,
+		GitStatus: status,
+		Selected:  selected,
+		Theme:     theme,
+	})
+	if err != nil {
+		return "", false
+	}
+
+	ctx, cancel := context.WithTimeout(context.Background(), pierreRenderTimeout)
+	defer cancel()
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, "http://pierre-ssr/tree", bytes.NewReader(payload))
+	if err != nil {
+		return "", false
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Idempotency-Key", pierreRequestKey("tree", id, theme, selected, strings.Join(paths, "\x00")))
+
+	resp, err := getPierreClient(socketPath).Do(req)
+	if err != nil {
+		return "", false
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return "", false
+	}
+
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return "", false
+	}
+
+	var out pierreRenderResponse
+	if err := json.Unmarshal(body, &out); err != nil {
+		return "", false
+	}
+	if out.HTML == "" {
+		return "", false
+	}
+	return template.HTML(out.HTML), true
+}
+
+// PierreTreeNode is a node in the server-rendered diff file tree.
+type PierreTreeNode struct {
+	Name     string
+	IsFile   bool
+	NameHash string
+	Type     DiffFileType
+	IsViewed bool
+	Children []*PierreTreeNode
+}
+
+// DiffIconName returns the octicon for this file's diff status, matching
+// Forgejo's DiffFileTreeItem.vue getIconForDiffType.
+func (n *PierreTreeNode) DiffIconName() string {
+	switch n.Type {
+	case DiffFileAdd:
+		return "octicon-diff-added"
+	case DiffFileChange:
+		return "octicon-diff-modified"
+	case DiffFileDel:
+		return "octicon-diff-removed"
+	case DiffFileRename, DiffFileCopy:
+		return "octicon-diff-renamed"
+	}
+	return ""
+}
+
+// DiffIconColor returns the color class paired with DiffIconName.
+func (n *PierreTreeNode) DiffIconColor() string {
+	switch n.Type {
+	case DiffFileAdd, DiffFileCopy:
+		return "green"
+	case DiffFileChange:
+		return "yellow"
+	case DiffFileDel:
+		return "red"
+	case DiffFileRename:
+		return "teal"
+	}
+	return ""
+}
+
+func pierreMergeSingleDirs(entries []*PierreTreeNode) {
+	for _, entry := range entries {
+		pierreMergeSingleDirs(entry.Children)
+		if len(entry.Children) == 1 && !entry.Children[0].IsFile {
+			entry.Name = entry.Name + "/" + entry.Children[0].Name
+			entry.Children = entry.Children[0].Children
+		}
+	}
+}
+
+// PierreDiffFileTree builds the nested file tree for a diff's files using the
+// same nesting and single-directory-merge rules as Forgejo's native
+// DiffFileTree.vue, so the tree can be server-rendered identically and painted
+// with the diffs instead of being built client-side by Vue.
+func PierreDiffFileTree(files []*DiffFile) []*PierreTreeNode {
+	var roots []*PierreTreeNode
+	for _, file := range files {
+		if file == nil || file.Name == "" {
+			continue
+		}
+		splits := strings.Split(file.Name, "/")
+		var parent *PierreTreeNode
+		siblings := &roots
+		for i, split := range splits {
+			isFile := i == len(splits)-1
+			var existing *PierreTreeNode
+			for _, child := range *siblings {
+				if child.Name == split {
+					existing = child
+					break
+				}
+			}
+			if existing == nil {
+				node := &PierreTreeNode{Name: split, IsFile: isFile}
+				if isFile {
+					node.NameHash = file.NameHash
+					node.Type = file.Type
+					node.IsViewed = file.IsViewed
+				}
+				*siblings = append(*siblings, node)
+				existing = node
+			}
+			parent = existing
+			siblings = &parent.Children
+		}
+	}
+	pierreMergeSingleDirs(roots)
+	return roots
+}
